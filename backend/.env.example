# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional provider & source keys (configurable from the UI Configuration panel)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tavily Search API key (get one at https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

PERPLEXITY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
YOUTUBE_API_KEY=
GITHUB_TOKEN=
KEYS_SAVED_AT=

# Pick models from https://openrouter.ai/models
# FAST_MODEL: choose a cheap, fast model for searching, section writing, and truth checking
# Example: openai/gpt-4o-mini or google/gemini-2.0-flash-001 or meta-llama/llama-3.3-70b-instruct
FAST_MODEL=openai/gpt-4o-mini

# SMART_MODEL: choose a stronger reasoning model for Apollo (planner), Hermes (reviewer), and final report assembly
# Example: anthropic/claude-3.5-sonnet or openai/gpt-4o or google/gemini-2.5-pro-preview
SMART_MODEL=openai/gpt-4o
